# Copy this file to .local/deployment.env and fill in values for your server.
# Never commit the populated file.
BASE_ROOT=/srv/www/example/standalonebase
MERGED_XML=/srv/www/example/extensions.xml
BOOTSTRAP_CONFIG=/srv/bootstrap/config.json
WEB_OWNER=web-user
BOOTSTRAP_OWNER=bootstrap-user
CONTAINER_NAME=bootstrap-container
SB_RELEASE_BASE_URL=https://downloads.example.invalid/standalonebase
SB_REMOTE_HOST=server.example.invalid
SB_REMOTE_USER=deploy-user
